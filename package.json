<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WINTECH Admin Dashboard</title>
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: Arial, Helvetica, sans-serif;
        background: linear-gradient(180deg, #041018 0%, #071821 100%);
        color: #edf6ff;
      }
      .container { max-width: 1200px; margin: 0 auto; padding: 20px; }
      header {
        background: rgba(12, 28, 37, 0.8);
        border-bottom: 1px solid rgba(255,255,255,0.08);
        padding: 20px 0;
      }
      h1 { color: #35e0a1; }
      .auth-box, .stats, .table-wrap {
        background: rgba(12, 28, 37, 0.8);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 16px;
        padding: 20px;
        margin: 20px 0;
      }
      input, button {
        padding: 10px 12px;
        border-radius: 8px;
        border: 1px solid rgba(255,255,255,0.1);
        font: inherit;
      }
      input {
        width: 100%;
        background: rgba(5, 14, 20, 0.7);
        color: #edf6ff;
        margin-bottom: 12px;
      }
      button {
        background: linear-gradient(135deg, #35e0a1, #85f0c7);
        color: #061922;
        font-weight: 700;
        border: none;
        cursor: pointer;
      }
      .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 16px;
      }
      .stat-card {
        background: rgba(255,255,255,0.02);
        border: 1px solid rgba(53,224,161,0.15);
        border-radius: 12px;
        padding: 18px;
      }
      .stat-card h3 { color: #a8bfd2; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.08em; }
      .stat-card .value { font-size: 2rem; font-weight: 800; color: #35e0a1; }
      table {
        width: 100%;
        border-collapse: collapse;
      }
      th, td {
        border-bottom: 1px solid rgba(255,255,255,0.06);
        padding: 12px;
        text-align: left;
      }
      th { color: #a8bfd2; text-transform: uppercase; font-size: 0.8rem; }
      .error { color: #ef4444; margin-top: 10px; }
      .success { color: #10b981; margin-top: 10px; }
      @media (max-width: 600px) {
        th, td { font-size: 0.82rem; }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="container">
        <h1>WINTECH Admin Dashboard</h1>
      </div>
    </header>

    <div class="container">
      <div class="auth-box">
        <h2>Admin Access</h2>
        <input type="password" id="adminKey" placeholder="Enter admin key" />
        <button onclick="loadDashboard()">Access Dashboard</button>
        <div id="authMessage"></div>
      </div>

      <div id="dashboard" style="display:none;">
        <div class="stats" id="stats"></div>

        <div class="table-wrap">
          <h3 style="margin-bottom: 12px;">Registrations</h3>
          <table>
            <thead>
              <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Plan</th>
                <th>Amount</th>
                <th>Status</th>
                <th>Date</th>
              </tr>
            </thead>
            <tbody id="membersBody"></tbody>
          </table>
        </div>
      </div>
    </div>

    <script>
      const API_URL = window.location.origin;

      async function loadDashboard() {
        const key = document.getElementById('adminKey').value.trim();
        if (!key) {
          document.getElementById('authMessage').innerHTML = '<div class="error">Please enter the admin key.</div>';
          return;
        }

        try {
          const statsRes = await fetch(`${API_URL}/api/admin/stats?key=${encodeURIComponent(key)}`);
          if (!statsRes.ok) {
            throw new Error('Unauthorized');
          }

          const statsData = await statsRes.json();
          const regsRes = await fetch(`${API_URL}/api/admin/registrations?key=${encodeURIComponent(key)}`);
          const regsData = await regsRes.json();

          const statsContainer = document.getElementById('stats');
          statsContainer.innerHTML = `
            <div class="stats-grid">
              <div class="stat-card">
                <h3>Total Registrations</h3>
                <div class="value">${statsData.totalRegistrations}</div>
              </div>
              <div class="stat-card">
                <h3>Total Value</h3>
                <div class="value">₦${statsData.totalValue.toLocaleString()}</div>
              </div>
              <div class="stat-card">
                <h3>Pending</h3>
                <div class="value">${statsData.pendingPayments}</div>
              </div>
              <div class="stat-card">
                <h3>Completed</h3>
                <div class="value">${statsData.completedPayments}</div>
              </div>
            </div>
          `;

          const body = document.getElementById('membersBody');
          if (!regsData.registrations || regsData.registrations.length === 0) {
            body.innerHTML = '<tr><td colspan="7">No registrations yet.</td></tr>';
          } else {
            body.innerHTML = regsData.registrations.map((r) => `
              <tr>
                <td>${r.fullName}</td>
                <td>${r.email}</td>
                <td>${r.phone}</td>
                <td>${r.plan}</td>
                <td>₦${r.amount.toLocaleString()}</td>
                <td>${r.paymentStatus}</td>
                <td>${new Date(r.registrationDate).toLocaleString()}</td>
              </tr>
            `).join('');
          }

          document.getElementById('dashboard').style.display = 'block';
          document.getElementById('authMessage').innerHTML = '<div class="success">Access granted.</div>';
        } catch (error) {
          document.getElementById('authMessage').innerHTML = '<div class="error">Invalid admin key.</div>';
        }
      }
    </script>
  </body>
</html>
